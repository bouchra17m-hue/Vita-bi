{
  "version": 2,
  "buildCommand": "npm install && cd pfevitabi && npm install && npm run build",
  "outputDirectory": "pfevitabi/dist",
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://vitabi-backend.boushera-bai.alwaysdata.net/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
