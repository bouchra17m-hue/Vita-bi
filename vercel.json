{
  "version": 2,
  "buildCommand": "npm install && cd pfevitabi && npm install && npm run build",
  "outputDirectory": "pfevitabi/dist",
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs24.x",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
